{
  "permissions": {
    "allow": [
      "Bash(bd:*)",
      "Bash(python3 .claude/scripts/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/setup-beads.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
