# Beads — the local database is generated by `bd import` on install.
# .beads/issues.jsonl IS tracked: it's the portable seed/export.
.beads/*
!.beads/issues.jsonl
!.beads/README.md
!.beads/memory-meta.jsonl

# Obsidian — workspace state is per-machine, config is shared
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Retrieval index — rebuilt by /reindex, never committed
.index/

# Memoryfield archives — outputs of /export-memoryfield
*.memoryfield.zip

# Python bytecode from the helper scripts
__pycache__/
