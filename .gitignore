# Beads — the local database is generated by `bd import` on install.
# .beads/issues.jsonl IS tracked: it's the portable seed/export.
.beads/*
!.beads/issues.jsonl
!.beads/README.md

# Obsidian — workspace state is per-machine, config is shared
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache

